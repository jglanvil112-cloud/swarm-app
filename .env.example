# Core runtime
PORT=4000
APP_VERSION=6.0.0
BASE_URL=http://localhost:4000
APP_URL=http://localhost:4000
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:4000

# Security — generate long random values in production
API_SECRET=
APPROVAL_SECRET=

# Supabase — server must use the service-role key
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# AI
ANTHROPIC_API_KEY=
AGENT_MODEL=claude-haiku-4-5-20251001
OPENAI_API_KEY=
VISION_MODEL=claude-haiku-4-5-20251001
AI_REQUESTS_PER_MINUTE=30

# Etsy
ETSY_KEY=
ETSY_SECRET=
ETSY_SHOP_ID=
ETSY_ACCESS_TOKEN=
ETSY_WHEN_MADE=2020_2026
ETSY_LOWRES_FLOOR_BYTES=512000
ETSY_MAX_FILE_BYTES=20971520
ALLOW_PUBLISH_WITHOUT_FILE=false
ENABLE_ETSY_METRICS_CRON=true

# Worker controls
TASK_MAX_RETRIES=3
AUTONOMOUS_PRODUCT_DROPS=false

# Shopify (optional unless Shopify features are used)
SHOPIFY_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_CLIENT_SECRET=

# Printify / Canva / image generation (optional features)
PRINTIFY_API_KEY=
CANVA_ACCESS_TOKEN=
FAL_KEY=

# Social platforms (optional features)
INSTAGRAM_ACCESS_TOKEN=
FACEBOOK_ACCESS_TOKEN=
TIKTOK_ACCESS_TOKEN=

# Render
RENDER_EXTERNAL_URL=
RENDER_INSTANCE_ID=

# GitHub Actions only; store this as a repository Actions secret, not in Render.
# SUPABASE_DB_URL=postgresql://...
